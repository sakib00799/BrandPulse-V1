# Local Docker-only password; replace for any shared deployment.
POSTGRES_PASSWORD=replace_with_a_long_random_value

# Browser-visible API origin used at frontend build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional non-Docker API overrides.
DATABASE_URL=sqlite:///data/interim/brandpulse.db
BRANDPULSE_MODEL_PATH=artifacts/baseline/baseline_model.joblib
BRANDPULSE_SEED_DATA=data/interim/dataset_normalized.parquet
BRANDPULSE_REPORTS_DIR=reports
BRANDPULSE_CORS_ORIGINS=http://localhost:3000
